.page {
  padding: 24rpx 30rpx 180rpx;
}

/* 继续学习卡 */
.continue {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: linear-gradient(135deg, #FF9A5A, #E5541E);
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 26rpx;
  box-shadow: 0 8rpx 22rpx rgba(229, 84, 30, 0.22);
}

.ct-play {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.24);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.ct-tri {
  width: 0;
  height: 0;
  border-style: solid;
  border-width: 14rpx 0 14rpx 22rpx;
  border-color: transparent transparent transparent #fff;
  margin-left: 6rpx;
}

.ct-info {
  flex: 1;
  min-width: 0;
}

.ct-label {
  font-size: 21rpx;
  color: rgba(255, 255, 255, 0.85);
}

.ct-name {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #fff;
  margin: 4rpx 0 10rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.ct-bar {
  height: 8rpx;
  background: rgba(255, 255, 255, 0.3);
  border-radius: 999rpx;
  overflow: hidden;
}

.ct-fill {
  height: 100%;
  background: #fff;
  border-radius: 999rpx;
}

.ct-pct {
  font-size: 26rpx;
  font-weight: 800;
  color: #fff;
  flex-shrink: 0;
}

/* 封面徽标 + 进度条 */
.c-badge {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  font-size: 20rpx;
  font-weight: 700;
  color: #fff;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
}

.c-badge.finished {
  background: rgba(18, 161, 80, 0.92);
}

.c-badge.student {
  background: rgba(43, 52, 64, 0.72);
}

.c-badge.lock {
  background: rgba(229, 84, 30, 0.95);
}

.c-badge.owned {
  background: rgba(47, 107, 216, 0.92);
}

.c-progress {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 8rpx;
  background: rgba(255, 255, 255, 0.35);
}

.c-progress-fill {
  height: 100%;
  background: #FF6B35;
}

.c-m.views {
  color: #b6bec7;
}

/* 分类 chips */
.cats {
  white-space: nowrap;
  margin-bottom: 26rpx;
}

.cat {
  display: inline-block;
  background: #fff;
  border: 3rpx solid #eef1f4;
  border-radius: 999rpx;
  padding: 12rpx 32rpx;
  margin-right: 16rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #8a94a0;
}

.cat.active {
  background: linear-gradient(135deg, #FF9A5A, #FF6B35);
  border-color: transparent;
  color: #fff;
  box-shadow: 0 6rpx 14rpx rgba(255, 107, 53, 0.3);
}

/* 课程卡 */
.c-list {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

.c-card {
  background: #fff;
  border: 3rpx solid #eef1f4;
  border-radius: 28rpx;
  overflow: hidden;
  box-shadow: 0 6rpx 18rpx rgba(0, 0, 0, 0.05);
}

.c-card:active {
  transform: translateY(2rpx);
}

.c-cover {
  height: 240rpx;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 60rpx;
}

.c-cover-img {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

.c-cover-text {
  color: rgba(255, 255, 255, 0.95);
  font-size: 40rpx;
  font-weight: 800;
  text-align: center;
  letter-spacing: 4rpx;
  text-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.15);
}

.c-play {
  position: absolute;
  right: 28rpx;
  bottom: 24rpx;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.92);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.15);
}

.c-play-tri {
  width: 0;
  height: 0;
  border-left: 22rpx solid #3c3c3c;
  border-top: 14rpx solid transparent;
  border-bottom: 14rpx solid transparent;
  margin-left: 6rpx;
}

.c-free {
  position: absolute;
  left: 24rpx;
  top: 22rpx;
  background: rgba(255, 255, 255, 0.92);
  color: #E5541E;
  font-size: 20rpx;
  font-weight: 700;
  border-radius: 999rpx;
  padding: 6rpx 18rpx;
}

.c-body {
  padding: 26rpx 30rpx 30rpx;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.c-name {
  font-size: 32rpx;
  font-weight: 700;
}

.c-intro {
  font-size: 24rpx;
  color: #8a94a0;
}

.c-meta {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-top: 6rpx;
}

.c-tag {
  background: #FFF0E6;
  color: #E5541E;
  font-size: 20rpx;
  font-weight: 600;
  border-radius: 999rpx;
  padding: 4rpx 16rpx;
}

.c-m {
  font-size: 22rpx;
  color: #aab3bd;
}

.foot-tip {
  text-align: center;
  font-size: 22rpx;
  color: #c2c9d1;
  padding: 30rpx 0;
}

.empty {
  text-align: center;
  color: #aab3bd;
  padding: 120rpx 0;
}
