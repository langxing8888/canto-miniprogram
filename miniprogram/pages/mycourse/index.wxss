page {
  background: #f5f6f8;
}

.wrap {
  padding: 24rpx 24rpx 60rpx;
}

/* ===== 课时包卡 ===== */
.pack-card {
  background: linear-gradient(135deg, #FF9A5A, #E5541E);
  border-radius: 24rpx;
  padding: 30rpx 32rpx 24rpx;
  color: #fff;
  box-shadow: 0 10rpx 28rpx rgba(229, 84, 30, 0.25);
}

.pack-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.pack-title {
  font-size: 32rpx;
  font-weight: 700;
}

.pack-status {
  font-size: 22rpx;
  background: rgba(255, 255, 255, 0.22);
  border-radius: 999rpx;
  padding: 6rpx 18rpx;
}

.pack-nums {
  display: flex;
  align-items: center;
  margin-top: 28rpx;
  background: rgba(255, 255, 255, 0.14);
  border-radius: 18rpx;
  padding: 22rpx 0;
}

.pk-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.pk-num {
  font-size: 44rpx;
  font-weight: 800;
  line-height: 1;
}

.pk-label {
  font-size: 22rpx;
  opacity: 0.85;
}

.pk-div {
  width: 1rpx;
  height: 48rpx;
  background: rgba(255, 255, 255, 0.3);
}

.pack-foot {
  margin-top: 18rpx;
  font-size: 22rpx;
  opacity: 0.85;
  text-align: right;
}

/* ===== 约课/课表按钮行 ===== */
.btn-row {
  display: flex;
  gap: 18rpx;
  margin: 24rpx 0 8rpx;
}

.book-btn {
  flex: 1;
  background: linear-gradient(135deg, #FF9A5A, #FF6B35);
  border: none;
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
  text-align: center;
  padding: 26rpx 0;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 18rpx rgba(255, 107, 53, 0.28);
}

.book-btn:active {
  opacity: 0.88;
}

.cal-btn {
  width: 120rpx;
  background: #fff;
  border: 2rpx solid #e8ebef;
  color: #2b3440;
  font-size: 28rpx;
  font-weight: 700;
  text-align: center;
  padding: 26rpx 0;
  border-radius: 20rpx;
  position: relative;
}

.dot-badge {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  min-width: 30rpx;
  height: 30rpx;
  line-height: 30rpx;
  padding: 0 8rpx;
  background: #e5342e;
  color: #fff;
  font-size: 20rpx;
  font-weight: 700;
  border-radius: 999rpx;
}

.cal-btn:active {
  background: #f2f4f6;
}

.sec-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #2b3440;
  margin: 30rpx 4rpx 18rpx;
}

.empty {
  text-align: center;
  color: #9aa3ae;
  font-size: 26rpx;
  padding: 60rpx 0;
}

/* ===== 课程卡 ===== */
.bk-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 26rpx 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(31, 41, 55, 0.05);
}

.bk-row1 {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.bk-time {
  font-size: 30rpx;
  font-weight: 700;
  color: #2b3440;
}

.bk-status {
  font-size: 22rpx;
  border-radius: 8rpx;
  padding: 4rpx 14rpx;
}

.s-booked {
  color: #12a150;
  background: #e9f9ef;
}

.s-done {
  color: #8a94a3;
  background: #f2f4f6;
}

.bk-row2 {
  margin-top: 10rpx;
  font-size: 25rpx;
  color: #6b7684;
}

/* 会议号区 */
.bk-meeting {
  margin-top: 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff7f3;
  border: 1rpx solid #ffe1d1;
  border-radius: 16rpx;
  padding: 18rpx 22rpx;
}

.bk-meet-label {
  display: block;
  font-size: 21rpx;
  color: #b58a72;
}

.bk-meet-code {
  display: block;
  font-size: 32rpx;
  font-weight: 800;
  color: #E5541E;
  margin-top: 4rpx;
}

.bk-copy {
  background: linear-gradient(135deg, #FF9A5A, #E5541E);
  color: #fff;
  font-size: 26rpx;
  font-weight: 700;
  padding: 16rpx 26rpx;
  border-radius: 999rpx;
}

.bk-copy:active {
  opacity: 0.85;
}

.bk-wait {
  margin-top: 18rpx;
  font-size: 23rpx;
  color: #9aa3ae;
  background: #f7f8fa;
  border-radius: 12rpx;
  padding: 14rpx 20rpx;
}

.bk-ops {
  margin-top: 16rpx;
  display: flex;
  justify-content: flex-end;
}

.bk-cancel {
  font-size: 24rpx;
  color: #9aa3ae;
  padding: 8rpx 4rpx;
}

/* ===== ���ڿ��˿� ===== */
.attend-card { display: flex; align-items: center; background: #fff; border-radius: 20rpx; padding: 28rpx 20rpx; margin-bottom: 20rpx; box-shadow: 0 4rpx 14rpx rgba(31,41,55,0.05); }
.at-item { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 6rpx; }
.at-num { font-size: 40rpx; font-weight: 800; color: #2b3440; }
.at-num.at-rate { color: #12a150; }
.at-num.at-absent { color: #e5342e; }
.at-label { font-size: 22rpx; color: #8a94a3; }
.at-div { width: 2rpx; height: 56rpx; background: #eef0f3; }
/* ÿ�ڿγ��ڻձ� */
.bk-attend { font-size: 22rpx; font-weight: 700; padding: 2rpx 14rpx; border-radius: 999rpx; margin-left: 12rpx; }
.bk-attend.a-present { background: #e8f6ee; color: #12a150; }
.bk-attend.a-leave { background: #fff3e0; color: #e8930c; }
.bk-attend.a-absent { background: #fdeaea; color: #e5342e; }
.bk-attend.a-none { background: #eef0f3; color: #8a94a3; }
