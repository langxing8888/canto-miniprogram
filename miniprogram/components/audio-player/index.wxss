/* 播放徽标 */
.sound-badge {
  position: absolute;
  right: -6rpx;
  bottom: -6rpx;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #FF6B35;
  border: 4rpx solid #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.15);
}

.sound-badge.on {
  background: #1cb0f6;
}

.badge-icon {
  width: 24rpx;
  height: 24rpx;
}

/* 小乌龟慢速 */
.turtle {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2rpx;
  background: #fff;
  border: 3rpx solid #e5e5e5;
  border-bottom-width: 6rpx;
  border-radius: 20rpx;
  padding: 12rpx 18rpx;
}

.turtle:active {
  transform: translateY(2rpx);
}

.turtle-icon {
  width: 44rpx;
  height: 44rpx;
}

.turtle-label {
  font-size: 20rpx;
  color: #8a94a0;
  font-weight: 600;
}
