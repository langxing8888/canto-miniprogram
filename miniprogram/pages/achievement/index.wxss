page {
  background: #f5f6f8;
}

.wrap {
  padding: 24rpx 24rpx 60rpx;
}

/* ===== 顶部总览 ===== */
.hero {
  position: relative;
  background: linear-gradient(135deg, #FF9A5A, #E5541E);
  border-radius: 24rpx;
  padding: 40rpx 36rpx;
  color: #fff;
  box-shadow: 0 10rpx 28rpx rgba(229, 84, 30, 0.25);
  display: flex;
  flex-direction: column;
}

.hero-title {
  font-size: 36rpx;
  font-weight: 800;
}

.hero-sub {
  font-size: 23rpx;
  opacity: 0.85;
  margin-top: 8rpx;
}

.hero-ring {
  position: absolute;
  right: 36rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 150rpx;
  height: 150rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.16);
  border: 6rpx solid rgba(255, 255, 255, 0.55);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.ring-num {
  font-size: 44rpx;
  font-weight: 800;
  line-height: 1;
}

.ring-pct {
  font-size: 22rpx;
  font-weight: 600;
}

.ring-label {
  font-size: 19rpx;
  opacity: 0.9;
  margin-top: 4rpx;
}

/* ===== 数据网格 ===== */
.grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  row-gap: 18rpx;
  margin-top: 24rpx;
}

.g-card {
  width: 48.6%;
  box-sizing: border-box;
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx 28rpx;
  position: relative;
  box-shadow: 0 4rpx 14rpx rgba(31, 41, 55, 0.05);
}

.g-num {
  font-size: 52rpx;
  font-weight: 800;
  color: #2b3440;
  line-height: 1;
}

.g-num.small {
  font-size: 38rpx;
}

.g-dim {
  font-size: 28rpx;
  color: #b6bec7;
  font-weight: 600;
}

.g-label {
  display: block;
  font-size: 23rpx;
  color: #8a94a3;
  margin-top: 14rpx;
}

.g-unit {
  position: absolute;
  right: 26rpx;
  top: 30rpx;
  font-size: 22rpx;
  color: #c2c9d1;
}

.foot-note {
  text-align: center;
  font-size: 22rpx;
  color: #b6bec7;
  margin-top: 34rpx;
}
