.audio-wrap {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.avatar {
  position: relative;
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid #FF6B35;
  box-shadow: 0 6rpx 16rpx rgba(255, 107, 53, 0.22);
  background-color: #FFF0E6;
  background-position: center;
  background-repeat: no-repeat;
  background-size: 82%;
}

.avatar.playing {
  animation: pulse 0.8s ease-in-out infinite;
}

@keyframes pulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.08); }
}

