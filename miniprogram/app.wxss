/* 全局样式：简洁清爽风格 */
page {
  background: #f7f8fa;
  font-size: 30rpx;
  color: #3c3c3c;
  font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
}

.btn-primary {
  background: linear-gradient(135deg, #FF9A5A, #FF6B35);
  color: #fff;
  border-radius: 32rpx;
  font-size: 34rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  padding: 24rpx 0;
  text-align: center;
  box-shadow: 0 6rpx 0 #E5541E, 0 10rpx 24rpx rgba(255, 107, 53, 0.25);
}

.btn-primary.disabled {
  background: #e5e5e5;
  color: #afafaf;
  box-shadow: 0 6rpx 0 #d0d0d0;
}

.btn-plain {
  background: #fff;
  color: #FF6B35;
  border: 3rpx solid #e5e5e5;
  border-radius: 32rpx;
  font-size: 32rpx;
  font-weight: 600;
  padding: 22rpx 0;
  text-align: center;
}

/* ============ 矢量图标库（内联 SVG，统一线性风格） ============ */
.icon {
  display: inline-block;
  width: 40rpx;
  height: 40rpx;
  background-position: center;
  background-repeat: no-repeat;
  background-size: contain;
  vertical-align: middle;
}

