page {
  background: #f5f6f8;
}

.wrap {
  padding: 24rpx 24rpx 60rpx;
}

/* ===== Tab ===== */
.tabs {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.tab {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  font-weight: 700;
  color: #8a94a3;
  background: #fff;
  border-radius: 999rpx;
  padding: 18rpx 0;
}

.tab.on {
  color: #fff;
  background: linear-gradient(135deg, #FF9A5A, #E5541E);
}

.empty {
  text-align: center;
  color: #9aa3ae;
  font-size: 26rpx;
  padding: 80rpx 0;
}

/* ===== 作业卡 ===== */
.hw-card {
  background: #fff;
  border-radius: 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 14rpx rgba(31, 41, 55, 0.05);
  overflow: hidden;
}

.hw-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 28rpx;
}

.hw-title {
  display: block;
  font-size: 29rpx;
  font-weight: 700;
  color: #2b3440;
}

.hw-end {
  display: block;
  font-size: 22rpx;
  color: #9aa3ae;
  margin-top: 6rpx;
}

.hw-toggle {
  font-size: 25rpx;
  font-weight: 700;
  color: #fff;
  background: linear-gradient(135deg, #FF9A5A, #E5541E);
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  flex-shrink: 0;
}

.hw-score {
  font-size: 34rpx;
  font-weight: 800;
  color: #12a150;
}

.hw-wait {
  font-size: 24rpx;
  color: #e5a11c;
}

.hw-body {
  border-top: 1rpx solid #f0f2f4;
  padding: 24rpx 28rpx 30rpx;
}

.hw-content {
  display: block;
  font-size: 26rpx;
  color: #4a5361;
  line-height: 1.7;
  white-space: pre-wrap;
  margin-bottom: 16rpx;
}

.hw-imgs {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.hw-imgs image {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  background: #f2f4f6;
}

.sec-label {
  font-size: 23rpx;
  font-weight: 700;
  color: #8a94a3;
  margin: 20rpx 0 12rpx;
}

/* ===== 提交区 ===== */
.sub-area {
  background: #f8f9fb;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-top: 10rpx;
}

.sub-text {
  width: 100%;
  min-height: 120rpx;
  font-size: 26rpx;
  line-height: 1.6;
  box-sizing: border-box;
  background: #fff;
  border-radius: 12rpx;
  padding: 18rpx;
}

.sub-imgs {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 16rpx;
}

.sub-img {
  position: relative;
}

.sub-img image {
  width: 150rpx;
  height: 150rpx;
  border-radius: 12rpx;
}

.sub-del {
  position: absolute;
  right: -10rpx;
  top: -10rpx;
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  background: rgba(0, 0, 0, 0.55);
  color: #fff;
  font-size: 22rpx;
  border-radius: 50%;
}

.sub-add {
  width: 150rpx;
  height: 150rpx;
  border: 2rpx dashed #c9d0d8;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: #8a94a3;
  text-align: center;
}

.sub-btn {
  margin-top: 20rpx;
  background: linear-gradient(135deg, #FF9A5A, #E5541E);
  color: #fff;
  font-size: 29rpx;
  font-weight: 700;
  text-align: center;
  padding: 22rpx 0;
  border-radius: 999rpx;
}

.sub-btn.dis {
  opacity: 0.6;
}

/* ===== 批改结果 ===== */
.grade-box {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  background: #e9f9ef;
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 8rpx;
  flex-wrap: wrap;
}

.grade-score {
  font-size: 56rpx;
  font-weight: 800;
  color: #12a150;
  line-height: 1;
}

.grade-label {
  font-size: 24rpx;
  color: #12a150;
}

.grade-comment {
  width: 100%;
  font-size: 25rpx;
  color: #3e6650;
  line-height: 1.6;
  margin-top: 12rpx;
}
